{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "NetSentry",
    "identifier": "com.netsentry",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1421",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "NetSentry",
                "width": 1200,
                "height": 800,
                "minWidth": 900,
                "minHeight": 600
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "copyright": "Popelyshyn",
        "shortDescription": "NetSentry Network Controller",
        "longDescription": "High-performance real-time network monitoring and traffic shaping",
        "icon": ["icons/icon.ico"],
        "windows": {
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": null
        },
        "createUpdaterArtifacts": true
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCNTlCMDVERkIxOTA2RDMKUldUVEJobjdYYkJaSzlNdmtrTkNCcXFFTVdxYVN4dGM0OVJibU9VTi90YklpRXN4M1U4WXRKTjkK",
            "endpoints": [
                "https://github.com/Loafer19/WindowsFix/releases/latest/download/ns-latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
