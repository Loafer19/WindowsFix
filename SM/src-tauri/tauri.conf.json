{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Services Manager",
    "identifier": "com.servicesmanager",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Windows Services Manager",
                "width": 1200,
                "height": 800,
                "minWidth": 800,
                "minHeight": 600,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "copyright": "Popelyshyn",
        "shortDescription": "Services Manager",
        "longDescription": "A desktop application for managing Windows services",
        "icon": ["icons/icon.ico"],
        "createUpdaterArtifacts": true
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCNTlCMDVERkIxOTA2RDMKUldUVEJobjdYYkJaSzlNdmtrTkNCcXFFTVdxYVN4dGM0OVJibU9VTi90YklpRXN4M1U4WXRKTjkK",
            "endpoints": [
                "https://github.com/Loafer19/WindowsFix/releases/latest/download/sm-latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
